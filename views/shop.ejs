<%- include('partials/head', { title: cat + ' – Zaraya Jewellery', extraCSS: 'shop.css' }) %>

<nav id="navbar">
  <a href="/" class="nav-logo">
    <img src="/img/logo.png" alt="Zaraya – The Jewellery House" class="nav-logo-img" />
  </a>
  <div class="nav-links">
    <a href="/#categories">Collection</a>
    <a href="/#about">About</a>
    <a href="/#contact">Contact</a>
  </div>
  <a href="/" class="nav-back">← Back to Home</a>
</nav>

<div class="shop-hero">
  <div class="shop-hero-inner">
    <div class="shop-breadcrumb">
      <a href="/">Home</a><span>›</span>
      <span><%= cat === 'All' ? 'All Products' : cat %></span>
    </div>
    <%
      const titles = {
        All:         'All <em>Collection</em>',
        Bracelets:   'Our <em>Bracelets</em>',
        Necklaces:   'Our <em>Necklaces</em>',
        Earrings:    'Our <em>Earrings</em>',
        Rings:       'Our <em>Rings</em>',
        Bangles:     'Our <em>Bangles</em>',
        Watches:     'Our <em>Watches</em>',
        Bestsellers: '<em>Best Sellers</em>'
      };
      const subs = {
        All:         'Every piece we make — lightweight, anti-tarnish, waterproof.',
        Bracelets:   'Worn every day. Styled every way.',
        Necklaces:   'Chains & pendants for every neckline.',
        Earrings:    'Studs & drops — effortless elegance.',
        Rings:       'Statement pieces for every finger.',
        Bangles:     'Stack them, layer them, love them.',
        Watches:     'Timepieces that complement every look.',
        Bestsellers: 'The pieces everyone is wearing right now.'
      };
    %>
    <h1 class="shop-title"><%- titles[cat] || 'Our <em>Collection</em>' %></h1>
    <p class="shop-subtitle"><%= subs[cat] || '' %></p>
  </div>
</div>

<div class="cat-tabs-wrap">
  <div class="cat-tabs">
    <% ['All','Bracelets','Necklaces','Earrings','Rings','Bangles','Watches','Bestsellers'].forEach(c => { %>
      <a href="/shop?cat=<%= c %>" class="cat-tab <%= cat === c ? 'active' : '' %>">
        <%= c === 'Bestsellers' ? '★ Best Sellers' : c %>
      </a>
    <% }) %>
  </div>
</div>

<div class="shop-body">
  <div class="shop-meta">
    <p class="shop-count"><strong><%= products.length %></strong> product<%= products.length !== 1 ? 's' : '' %></p>
    <div class="shop-sort">
      <span>Sort by</span>
      <select id="sortSel">
        <option value="default">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="name">Name A–Z</option>
      </select>
    </div>
  </div>

  <div class="shop-grid">
    <% if (products.length === 0) { %>
      <div class="shop-empty">
        <div class="shop-empty-icon">◇</div>
        <p class="shop-empty-title">No items here yet</p>
        <p class="shop-empty-sub">Check back soon — new pieces are on the way.</p>
      </div>
    <% } else { %>
      <% products.forEach((p, i) => {
           const isBs = p.bestseller || p.badge === 'Bestseller';
      %>
        <div class="scard rv" style="transition-delay:<%= i * 0.05 %>s"
          data-name="<%= p.name %>"
          data-price="<%= p.price %>"
          data-cat="<%= p.cat %>"
          data-badge="<%= p.badge || '' %>"
          data-stock="<%= p.stock %>"
          data-img="<%= p.image || '' %>"
          data-images="<%= JSON.stringify([p.image, ...(p.images||[])].filter(Boolean)) %>"
          onclick="openProduct(this)">
          <div class="scard-img">
            <% if (p.image) { %>
              <img src="<%= p.image %>" alt="<%= p.name %>" style="width:100%;height:100%;object-fit:cover;" />
            <% } else { %>
              <%- jewel(p.cat, p.color) %>
            <% } %>
            <% if (isBs) { %>
              <span class="bs-star">★ Best Seller</span>
            <% } else if (p.badge) { %>
              <span class="scard-badge"><%= p.badge %></span>
            <% } %>
            <% if (!p.stock) { %><span class="scard-oos">Out of Stock</span><% } %>
          </div>
          <div class="scard-body">
            <span class="scard-cat"><%= p.cat %></span>
            <p class="scard-name"><%= p.name %></p>
            <div class="scard-foot">
              <span class="scard-price">₹<%= p.price.toLocaleString() %></span>
              <button class="scard-btn" <%= !p.stock ? 'disabled' : '' %>
                data-name="<%= p.name %>" data-price="<%= p.price %>"
                onclick="event.stopPropagation(); if(!this.disabled) addToCart(this.dataset.name, parseInt(this.dataset.price))">
                <%= p.stock ? 'Add to Cart' : 'Out of Stock' %>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<div class="shop-footer">
  <div class="sf-links">
    <% ['All','Bracelets','Necklaces','Earrings','Rings','Bangles','Watches','Bestsellers'].forEach(c => { %>
      <a href="/shop?cat=<%= c %>"><%= c === 'Bestsellers' ? 'Best Sellers' : c %></a>
    <% }) %>
  </div>
  <p class="sf-copy">© 2025 Zaraya Jewellery · The Jewellery House · Calicut, Kerala</p>
</div>
<!-- Cart Button -->
<div id="cart-fab" onclick="openCart()" style="display:none;position:fixed;bottom:2rem;right:2rem;z-index:900;background:#C9A84C;color:#072e24;border:none;padding:.9rem 1.6rem;cursor:pointer;font-family:'Jost',sans-serif;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;display:flex;align-items:center;gap:.6rem;">
  <span>🛒 Cart</span><span id="cart-count" style="background:#072e24;color:#C9A84C;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:.68rem;">0</span>
</div>

<!-- Cart Sidebar -->
<div id="cart-sidebar" style="display:none;position:fixed;top:0;right:0;width:340px;height:100vh;background:#072e24;border-left:1px solid rgba(201,168,76,.3);z-index:998;padding:2rem;overflow-y:auto;flex-direction:column;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
    <h2 style="font-family:'Cormorant Garamond',serif;color:#C9A84C;font-size:1.4rem;font-weight:300;">Your Cart</h2>
    <button onclick="closeCart()" style="background:none;border:none;color:#C9A84C;font-size:1.4rem;cursor:pointer;">✕</button>
  </div>
  <div id="cart-items" style="flex:1;"></div>
  <div id="cart-total" style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid rgba(201,168,76,.2);font-family:'Cormorant Garamond',serif;font-size:1.2rem;color:#C9A84C;"></div>
  <button onclick="proceedToOrder()" id="order-btn" style="margin-top:1.2rem;width:100%;padding:.9rem;background:#C9A84C;color:#072e24;border:none;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;font-family:'Jost',sans-serif;">Place Order</button>
</div>

<!-- Terms Modal -->
<div id="terms-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:999;align-items:center;justify-content:center;">
  <div style="background:#072e24;border:1px solid rgba(201,168,76,.3);max-width:560px;width:90%;max-height:80vh;overflow-y:auto;padding:2.5rem;position:relative;">
    <button onclick="closeTerms()" style="position:absolute;top:1rem;right:1.2rem;background:none;border:none;color:#C9A84C;font-size:1.4rem;cursor:pointer;">✕</button>
    <h2 style="font-family:'Cormorant Garamond',serif;color:#C9A84C;font-size:1.6rem;font-weight:300;margin-bottom:1.5rem;">Terms & Conditions</h2>
    <div style="font-size:.78rem;color:rgba(245,233,200,.75);line-height:1.9;">
      <p><strong style="color:#C9A84C;">1. Skin & Allergy Awareness</strong><br>Our jewelry products are crafted to be safe for all skin types. However, customers are advised to be aware of their personal skin conditions and allergies prior to use. We recommend conducting a patch test to identify any potential allergic reactions before prolonged or continuous wear.</p><br>
      <p><strong style="color:#C9A84C;">2. Health and Liability Disclaimer</strong><br>We disclaim responsibility for any health complications, allergic reactions, or other adverse effects arising from the use of our products. Customers should consult a healthcare professional if uncertain about skin sensitivities.</p><br>
      <p><strong style="color:#C9A84C;">3. Payment Terms</strong><br>Full payment must be completed prior to order confirmation. No orders will be processed after receipt of full payment.</p><br>
      <p><strong style="color:#C9A84C;">4. Order Confirmation and Cancellation</strong><br>All orders are subject to availability and final confirmation. We reserve the right to cancel any order for reasons beyond our control such as stock shortages or payment failures. Customers may cancel orders within 24 hours of confirmation; cancellations beyond this timeframe will be handled on a case-by-case basis.</p><br>
      <p><strong style="color:#C9A84C;">5. Customer Responsibility</strong><br>Customers are responsible for inspecting the product at the time of pickup. Any visible defects or discrepancies should be reported immediately to facilitate prompt resolution.</p><br>
      <p><strong style="color:#C9A84C;">6. Refund Policy</strong><br>Refunds outside of the guarantee period are subject to individual evaluation. All refund requests require presentation of the original purchase receipt and intact packaging. Zaraya jewelry reserves the right to approve or deny refund requests based on the condition of the returned product.</p><br>
      <p><strong style="color:#C9A84C;">7. Guarantee</strong><br>All items purchased from Zaraya jewelry are covered by a manufacturer's guarantee valid for 30 days from the date of purchase. This guarantee protects against any defects in material or workmanship under normal use.</p><br>
      <p><strong style="color:#C9A84C;">8. Replacement Policy</strong><br>In the event a product exhibits defects covered under the guarantee, we will replace the item with the identical design. Should the same design be unavailable due to stock limitations, a replacement with an alternative design of equal value will be offered. If neither option is feasible, a refund will be processed as a last resort.</p><br>
      <p><strong style="color:#C9A84C;">9. Damage and Misuse</strong><br>Zaraya jewelry is not liable for any damage resulting from misuse, neglect, accidents, physical abuse, or improper handling of the product. Any physical damage caused by harsh usage is excluded from the guarantee.</p>
    </div>
    <div style="margin-top:1.8rem;display:flex;align-items:center;gap:.8rem;">
      <input type="checkbox" id="terms-check" style="width:16px;height:16px;accent-color:#C9A84C;cursor:pointer;">
      <label for="terms-check" style="font-size:.78rem;color:rgba(245,233,200,.8);cursor:pointer;">I have read and agree to the Terms & Conditions</label>
    </div>
    <!-- Honeypot: invisible to humans, bots fill it -->
    <input type="text" id="order-hp" name="website" style="position:absolute;left:-9999px;top:-9999px;opacity:0;height:0;width:0;" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button id="terms-confirm" onclick="confirmOrder()" disabled style="margin-top:1.2rem;width:100%;padding:.9rem;background:#C9A84C;color:#072e24;border:none;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;cursor:not-allowed;opacity:.5;font-family:'Jost',sans-serif;">
      Confirm Order via WhatsApp
    </button>
  </div>
</div>

<script>
let cart = JSON.parse(localStorage.getItem('zaraya-cart') || '[]');
updateCartUI();

// Escape HTML to prevent XSS when rendering cart items
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function addToCart(name, price) {
  const existing = cart.find(i => i.name === name);
  if (existing) { existing.qty++; }
  else { cart.push({ name, price, qty: 1 }); }
  updateCartUI();
  const badge = document.getElementById('cart-count');
  badge.style.transition = 'transform .15s';
  badge.style.transform = 'scale(1.5)';
  setTimeout(() => { badge.style.transform = 'scale(1)'; }, 180);
}

function removeFromCart(name) {
  cart = cart.filter(i => i.name !== name);
  updateCartUI();
}

function updateCartUI() {
  localStorage.setItem('zaraya-cart', JSON.stringify(cart));
  const count = cart.reduce((s, i) => s + i.qty, 0);
  document.getElementById('cart-count').textContent = count;
  const fab = document.getElementById('cart-fab');
  fab.style.display = count > 0 ? 'flex' : 'none';

  const itemsEl = document.getElementById('cart-items');
  if (cart.length === 0) {
    itemsEl.innerHTML = '<p style="color:rgba(245,233,200,.5);font-size:.8rem;">Your cart is empty.</p>';
    document.getElementById('cart-total').textContent = '';
  } else {
    itemsEl.innerHTML = cart.map(i => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:.8rem 0;border-bottom:1px solid rgba(201,168,76,.1);">
        <div>
          <p style="color:#f5e9c8;font-size:.82rem;">${esc(i.name)}</p>
          <p style="color:rgba(201,168,76,.7);font-size:.72rem;">₹${Number(i.price).toLocaleString()} × ${Number(i.qty)}</p>
        </div>
        <div style="display:flex;align-items:center;gap:.8rem;">
          <span style="color:#C9A84C;font-size:.85rem;">₹${(i.price * i.qty).toLocaleString()}</span>
          <button data-name="${esc(i.name)}" onclick="removeFromCart(this.dataset.name)" style="background:none;border:none;color:rgba(201,168,76,.5);cursor:pointer;font-size:1rem;">✕</button>
        </div>
      </div>
    `).join('');
    const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
    document.getElementById('cart-total').textContent = `Total: ₹${total.toLocaleString()}`;
  }
}

function openCart() {
  document.getElementById('cart-sidebar').style.display = 'flex';
}
function closeCart() {
  document.getElementById('cart-sidebar').style.display = 'none';
}
function proceedToOrder() {
  if (cart.length === 0) return;
  closeCart();
  document.getElementById('terms-modal').style.display = 'flex';
  document.getElementById('terms-check').checked = false;
  const btn = document.getElementById('terms-confirm');
  btn.disabled = true;
  btn.style.opacity = '.5';
  btn.style.cursor = 'not-allowed';
}
function closeTerms() {
  document.getElementById('terms-modal').style.display = 'none';
}
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('terms-check').addEventListener('change', function() {
    const btn = document.getElementById('terms-confirm');
    btn.disabled = !this.checked;
    btn.style.opacity = this.checked ? '1' : '.5';
    btn.style.cursor = this.checked ? 'pointer' : 'not-allowed';
  });
});

async function confirmOrder() {
  const btn = document.getElementById('terms-confirm');
  btn.disabled = true;
  btn.style.opacity = '.7';
  btn.textContent = 'Processing…';

  try {
    const res = await fetch('/api/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: cart,
        website: document.getElementById('order-hp').value
      })
    });

    if (res.status === 429) {
      alert('You have placed too many orders recently. Please wait a while before trying again.');
      btn.disabled = false; btn.style.opacity = '1'; btn.textContent = 'Confirm Order via WhatsApp';
      return;
    }
    if (!res.ok) throw new Error('Server error');

    const { url } = await res.json();
    if (!url) throw new Error('No URL');

    window.open(url, '_blank');
    closeTerms();
    cart = [];
    localStorage.removeItem('zaraya-cart');
    updateCartUI();
  } catch(e) {
    alert('Something went wrong. Please try again.');
    btn.disabled = false; btn.style.opacity = '1'; btn.textContent = 'Confirm Order via WhatsApp';
  }
}

/* ── Gallery state ── */
let ppImages = [], ppIdx = 0, ppTouchX = null;

function ppGoTo(idx) {
  ppIdx = Math.max(0, Math.min(idx, ppImages.length - 1));
  document.getElementById('pp-slides').style.transform = 'translateX(' + (-ppIdx * 100) + '%)';
  document.querySelectorAll('.pp-dot').forEach((d, i) => d.classList.toggle('active', i === ppIdx));
  const prev = document.getElementById('pp-prev'), next = document.getElementById('pp-next');
  if (prev) prev.style.display = ppImages.length > 1 && ppIdx > 0 ? 'flex' : 'none';
  if (next) next.style.display = ppImages.length > 1 && ppIdx < ppImages.length - 1 ? 'flex' : 'none';
}

function openProduct(card) {
  const name  = card.dataset.name;
  const price = parseInt(card.dataset.price);
  const cat   = card.dataset.cat;
  const badge = card.dataset.badge;
  const stock = card.dataset.stock === 'true';
  let   imgs  = [];
  try { imgs = JSON.parse(card.dataset.images || '[]'); } catch {}
  if (imgs.length === 0 && card.dataset.img) imgs = [card.dataset.img];

  document.getElementById('pp-name').textContent  = name;
  document.getElementById('pp-price').textContent = '₹' + price.toLocaleString('en-IN');
  document.getElementById('pp-cat').textContent   = cat + (badge ? ' · ' + badge : '');
  document.getElementById('pp-status').textContent = stock ? '' : 'Currently Out of Stock';

  const slides = document.getElementById('pp-slides');
  const dots   = document.getElementById('pp-dots');
  if (imgs.length > 0) {
    slides.innerHTML = imgs.map(src =>
      '<div class="pp-slide"><img src="' + src + '" alt="' + esc(name) + '"/></div>'
    ).join('');
    dots.innerHTML = imgs.length > 1 ? imgs.map((_, i) =>
      '<button class="pp-dot' + (i === 0 ? ' active' : '') + '" onclick="ppGoTo(' + i + ')"></button>'
    ).join('') : '';
  } else {
    const srcEl = card.querySelector('.scard-img');
    slides.innerHTML = '<div class="pp-slide">' + (srcEl ? srcEl.innerHTML : '') + '</div>';
    dots.innerHTML = '';
  }
  ppImages = imgs;
  ppIdx = 0;
  slides.style.transform = 'translateX(0)';
  const prev = document.getElementById('pp-prev'), next = document.getElementById('pp-next');
  if (prev) prev.style.display = 'none';
  if (next) next.style.display = imgs.length > 1 ? 'flex' : 'none';

  const btn = document.getElementById('pp-btn');
  btn.disabled = !stock;
  btn.textContent = stock ? 'Add to Cart' : 'Out of Stock';
  btn.onclick = stock ? () => { addToCart(name, price); closePopup(); } : null;

  document.getElementById('pp-overlay').classList.add('active');
  document.getElementById('prod-popup').classList.add('active');
  document.body.classList.add('popup-open');
}

function closePopup() {
  document.getElementById('pp-overlay').classList.remove('active');
  document.getElementById('prod-popup').classList.remove('active');
  document.body.classList.remove('popup-open');
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closePopup(); });

/* Touch swipe for gallery */
document.addEventListener('touchstart', e => {
  if (!document.getElementById('prod-popup').classList.contains('active')) return;
  ppTouchX = e.touches[0].clientX;
}, { passive: true });
document.addEventListener('touchend', e => {
  if (ppTouchX === null) return;
  const dx = e.changedTouches[0].clientX - ppTouchX;
  if (dx < -40) ppGoTo(ppIdx + 1);
  else if (dx > 40) ppGoTo(ppIdx - 1);
  ppTouchX = null;
});
</script>

<!-- Product Detail Popup -->
<div id="pp-overlay" onclick="closePopup()"></div>
<div id="prod-popup" role="dialog" aria-modal="true">
  <button class="pp-close" onclick="closePopup()" aria-label="Close">✕</button>
  <div id="pp-img-wrap">
    <div class="pp-slides" id="pp-slides"></div>
    <div class="pp-dots" id="pp-dots"></div>
    <button class="pp-arr pp-prev" id="pp-prev" onclick="ppGoTo(ppIdx-1)" style="display:none">&#8249;</button>
    <button class="pp-arr pp-next" id="pp-next" onclick="ppGoTo(ppIdx+1)" style="display:none">&#8250;</button>
  </div>
  <div class="pp-body">
    <span class="pp-cat-lbl" id="pp-cat"></span>
    <h2 class="pp-name" id="pp-name"></h2>
    <p class="pp-price" id="pp-price"></p>
    <p class="pp-status" id="pp-status"></p>
    <button class="pp-add-btn" id="pp-btn">Add to Cart</button>
  </div>
</div>

<script src="/js/shop.js"></script>
</body>
</html>
