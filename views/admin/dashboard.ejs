<%- include('../partials/admin-layout', { title: 'Overview', page: 'overview' }) %>

<div class="stat-strip">
  <div class="stat-box hl"><span class="stat-val"><%= total %></span><span class="stat-lbl">Total Products</span></div>
  <div class="stat-box"><span class="stat-val"><%= visible %></span><span class="stat-lbl">Visible on Site</span></div>
  <div class="stat-box"><span class="stat-val"><%= outOfStock %></span><span class="stat-lbl">Out of Stock</span></div>
  <div class="stat-box"><span class="stat-val"><%= hidden %></span><span class="stat-lbl">Hidden Items</span></div>
</div>

<div class="view-hdr">
  <span class="view-title">All Products</span>
  <a href="/admin/add" class="add-btn">
    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add New Product
  </a>
</div>

<div class="ov-list">
  <% products.forEach(p => { %>
  <div class="ov-item">
    <div>
      <span class="ov-name"><%= p.name %></span>
      <span class="ov-cat"><%= p.cat %></span>
    </div>
    <div class="ov-right">
      <span class="ov-price">₹<%= p.price.toLocaleString() %></span>
      <span class="pill <%= p.stock ? 'p-in' : 'p-out' %>"><%= p.stock ? 'In Stock' : 'Out of Stock' %></span>
      <span class="pill <%= p.visible ? 'p-vis' : 'p-hid' %>"><%= p.visible ? 'Visible' : 'Hidden' %></span>
    </div>
  </div>
  <% }) %>
</div>

<%- include('../partials/admin-layout-end') %>
