<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <meta name="theme-color" content="#072e24"/>
  <title>Admin Login – Zaraya</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/admin.css"/>
</head>
<body>
<div class="login-wrap">
  <div class="lb">
    <div class="lb-logo">
      <img src="/img/logo.png" alt="Zaraya" style="height:130px;width:auto;object-fit:contain;" />
    </div>
    <h2 class="lb-title">Admin Login</h2>
    <p class="lb-sub">Zaraya Jewellery · Dashboard</p>
    <% if (error) { %><div class="lb-err"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <input class="lb-field" type="text"     name="username" placeholder="Username" autocomplete="off" autocapitalize="off" required/>
      <input class="lb-field" type="password" name="password" placeholder="Password" required/>
      <button class="lb-go" type="submit">Enter Dashboard →</button>
    </form>
    <a href="/" class="lb-back">← Back to Site</a>
  </div>
</div>
</body>
</html>
