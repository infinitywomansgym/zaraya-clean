<%- include('../partials/admin-layout', { title: 'Manage Products', page: 'products' }) %>

<div class="view-hdr">
  <span class="view-title">All Products (<%= products.length %>)</span>
  <a href="/admin/add" class="add-btn">
    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add New Product
  </a>
</div>

<div class="table-wrap">
<table class="admin-table">
  <thead>
    <tr>
      <th>Photos</th>
      <th>Product Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>Stock</th>
      <th>Visibility</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
    <tr>
      <!-- PHOTOS COLUMN -->
      <td style="padding:.5rem .75rem;vertical-align:top;">
        <div class="prod-photos">
          <!-- Primary image — click to replace -->
          <div class="photo-thumb primary-photo" title="Click to replace main photo">
            <% if (p.image) { %>
              <img src="<%= p.image %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;"/>
            <% } else { %>
              <div class="photo-empty">Main</div>
            <% } %>
            <div class="photo-overlay">Replace</div>
            <form method="POST" action="/admin/products/<%= p.id %>/image" enctype="multipart/form-data" style="position:absolute;inset:0;">
              <label style="display:block;width:100%;height:100%;cursor:pointer;">
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="this.closest('form').submit()"/>
              </label>
            </form>
          </div>
          <!-- Gallery images -->
          <% (p.images || []).forEach((img, idx) => { %>
          <div class="photo-thumb gallery-photo">
            <img src="<%= img %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;"/>
            <form method="POST" action="/admin/products/<%= p.id %>/gallery/<%= idx %>/delete" style="position:absolute;top:2px;right:2px;" onsubmit="return confirm('Remove this photo?')">
              <button type="submit" class="photo-del" title="Remove">✕</button>
            </form>
          </div>
          <% }) %>
          <!-- Add to gallery -->
          <div class="photo-thumb photo-add" title="Add photo to gallery">
            <form method="POST" action="/admin/products/<%= p.id %>/gallery" enctype="multipart/form-data" style="width:100%;height:100%;">
              <label style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;cursor:pointer;color:#C8A840;font-size:1.5rem;font-weight:300;">
                +
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="this.closest('form').submit()"/>
              </label>
            </form>
          </div>
        </div>
      </td>

      <td class="td-name"><%= p.name %></td>
      <td style="color:#5a5a5a;font-size:.78rem"><%= p.cat %><% if(p.badge){ %> · <em><%= p.badge %></em><% } %></td>
      <td class="td-price">₹<%= p.price.toLocaleString() %></td>
      <td><span class="pill <%= p.stock ? 'p-in' : 'p-out' %>"><%= p.stock ? '✓ In Stock' : '✕ Out of Stock' %></span></td>
      <td><span class="pill <%= p.visible ? 'p-vis' : 'p-hid' %>"><%= p.visible ? '👁 Visible' : '◌ Hidden' %></span></td>
      <td>
        <div class="acts">
          <!-- HIDE / SHOW -->
          <form method="POST" action="/admin/products/<%= p.id %>/toggle-visibility" style="display:inline">
            <button class="aact <%= p.visible ? 'a-hide' : 'a-show' %>" type="submit">
              <%= p.visible ? '🙈 Hide' : '👁 Show' %>
            </button>
          </form>
          <!-- STOCK -->
          <form method="POST" action="/admin/products/<%= p.id %>/toggle-stock" style="display:inline">
            <button class="aact <%= p.stock ? 'a-oos' : 'a-ins' %>" type="submit">
              <%= p.stock ? 'Mark OOS' : 'Mark In Stock' %>
            </button>
          </form>
          <!-- DELETE -->
          <form method="POST" action="/admin/products/<%= p.id %>/delete" style="display:inline"
            onsubmit="return confirm('Delete <%= p.name %>? This cannot be undone.')">
            <button class="aact a-del" type="submit">🗑 Delete</button>
          </form>
        </div>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>

<%- include('../partials/admin-layout-end') %>
